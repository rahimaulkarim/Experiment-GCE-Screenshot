{
  "manifest_version": 3,
  "name": "Full Screen Capture",
  "version": "1.0.1",
  "description": "Capture the visible browser screen and download it as a JPG or PDF.",
  "permissions": ["activeTab", "downloads"],
  "action": {
    "default_title": "Full Screen Capture",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon.svg",
    "48": "icons/icon.svg",
    "128": "icons/icon.svg"
  }
}
